@model Room
@{ ViewData["Title"] = Model.RoomType.Name; var stay = (StayInput)ViewBag.Stay; }
<section class="container section"><a href="@(ViewBag.SearchReturnUrl ?? Url.Action("Index", new { arrivalDate = stay.ArrivalDate.ToString("yyyy-MM-dd"), departureDate = stay.DepartureDate.ToString("yyyy-MM-dd"), guestCount = stay.GuestCount }))" class="back-link">← Quay lại danh sách phòng</a>
<div class="section-heading"><div><div class="eyebrow">PHÒNG @Model.RoomNumber · AURORA COLLECTION</div><h1>@Model.RoomType.Name</h1></div><span class="tag">Tối đa @Model.RoomType.Capacity khách</span></div>
<img class="detail-hero" src="@Model.ImagePath" alt="Phòng @Model.RoomType.Name với nội thất hiện đại" />
<div class="detail-grid"><div><div class="eyebrow">DÀNH CHO NHỮNG KHOẢNH KHẮC THẢNH THƠI</div><h2>Ở lại, và tận hưởng.</h2><div class="rich-copy">@Html.Raw(Model.Description)</div><h3>Tiện nghi trong phòng</h3><div class="amenity-list">@foreach (var amenity in Model.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries)) { <span>✓ @amenity.Trim()</span> }</div><div class="notice">Giá hiển thị là giá dự kiến. Lễ tân sẽ kiểm tra khả dụng và chốt giá khi xác nhận đơn.</div></div>
<aside class="panel booking-panel"><div class="eyebrow">KỲ NGHỈ CỦA BẠN</div><h3>@Ui.Money(Model.NightlyRate) <small>/ đêm</small></h3><form asp-controller="Bookings" asp-action="Select" method="post" class="stay-estimate" data-rate="@Model.NightlyRate.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"><input type="hidden" name="RoomId" value="@Model.Id" /><partial name="_StayFields" model="stay" /><div class="estimate-total" aria-live="polite"></div><button class="btn btn-primary w-100">Chọn phòng này →</button><p class="form-note">Đăng nhập để gửi yêu cầu. Chưa thanh toán ở bước này.</p></form></aside></div></section>
