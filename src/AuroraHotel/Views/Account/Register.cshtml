@inject Microsoft.Extensions.Options.IOptions<HotelOptions> Hotel
@model RegisterInput
@{ ViewData["Title"] = "Tạo tài khoản"; }
<section class="auth-shell"><div class="auth-photo"><div class="eyebrow">@Hotel.Value.Name.ToUpperInvariant()</div><h2>Chạm vào<br />những bình yên.</h2><p>Lưu giữ mọi kỳ nghỉ trong một tài khoản.</p></div><div class="auth-form"><div class="eyebrow">HẸN GẶP BẠN Ở AURORA</div><h1>Tạo tài khoản</h1><form asp-action="Register" method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="field"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
<div class="form-grid"><div class="field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone"></span></div></div>
<div class="field"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span><small>Ít nhất 8 ký tự; gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary w-100">Tạo tài khoản →</button></form><p class="form-note">Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a></p></div></section>
