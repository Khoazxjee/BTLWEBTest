@model BookingPage
@{ ViewData["Title"] = "Yêu cầu đặt phòng"; }
<section class="container section"><div class="eyebrow">01 CHỌN PHÒNG ── <strong>02 YÊU CẦU ĐẶT PHÒNG</strong> ── 03 CHỜ XÁC NHẬN</div><h1>Kỳ nghỉ đang đến gần.</h1><div class="detail-grid"><div class="panel"><h2>Thông tin đặt phòng</h2><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="guest-summary"><strong>@Model.Guest.FullName</strong><p>@Model.Guest.Email · @Model.Guest.Phone</p><a asp-controller="Account" asp-action="Profile">Cập nhật liên hệ ↗</a></div><form asp-action="Create" method="post" class="stay-estimate" data-rate="@Model.Room.NightlyRate.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"><input type="hidden" name="RoomId" value="@Model.Room.Id" /><partial name="_StayFields" model="Model.Input" /><div class="estimate-total" aria-live="polite"></div><div class="notice">Yêu cầu ở trạng thái <strong>Đang chờ xác nhận</strong> và chưa giữ chỗ. Không cần thanh toán trực tuyến.</div><button class="btn btn-primary">Gửi yêu cầu đặt phòng →</button></form></div><aside class="room-card"><img src="@Model.Room.ImagePath" class="summary-image" alt="@Model.Room.RoomType.Name" /><div class="room-content"><div class="eyebrow">PHÒNG @Model.Room.RoomNumber</div><h2>@Model.Room.RoomType.Name</h2><p>Tối đa @Model.Room.RoomType.Capacity khách</p><strong>@Ui.Money(Model.Room.NightlyRate) / đêm</strong><p class="muted mt-3">Giá dự kiến được đọc lại từ hệ thống khi gửi yêu cầu.</p></div></aside></div></section>
