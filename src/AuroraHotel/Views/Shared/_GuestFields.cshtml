@model GuestInput
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Id" type="hidden" />
<div class="field"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
<div class="field"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone"></span></div>
<div class="field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span></div>
