@{ ViewData["Title"] = "Thông báo"; var code = (int?)ViewBag.Code ?? 500; }
<section class="container section empty-state"><span>@code</span><h1>@(code == 404 ? "Không tìm thấy trang" : code == 403 ? "Bạn không có quyền truy cập" : "Chưa thể xử lý yêu cầu")</h1>
<p>@(code == 500 ? "Vui lòng thử lại sau. Nếu lỗi tiếp diễn, hãy liên hệ lễ tân." : "Hãy kiểm tra đường dẫn hoặc trở về trang chủ để tiếp tục.")</p><a class="btn btn-primary" asp-controller="Home" asp-action="Index" asp-area="">Về trang chủ →</a></section>
