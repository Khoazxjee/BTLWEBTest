@model List<Room>
@{ ViewData["Title"] = "Tình trạng phòng"; }
<div class="section-heading"><div><div class="eyebrow">ROOM BOARD</div><h1>Mỗi căn phòng, một trạng thái.</h1><p class="page-subtitle">Có khách / trống, dọn phòng và khai thác được theo dõi riêng.</p></div><a class="btn btn-light" asp-controller="FrontDesk" asp-action="Index">Mở lễ tân ↗</a></div>
<form method="get" class="toolbar"><div class="field"><label for="type">Loại phòng</label><select id="type" name="type" class="form-select"><option value="">Tất cả loại phòng</option>@foreach (RoomType t in ViewBag.Types) { <option value="@t.Id" selected="@(Context.Request.Query["type"] == t.Id.ToString())">@t.Name</option> }</select></div><div class="field"><label for="state">Lọc trạng thái</label><select id="state" name="state" class="form-select">@foreach (var pair in new Dictionary<string,string>{{"","Tất cả trạng thái"},{"occupied","Đang có khách"},{"vacant","Phòng trống"},{"clean","Đã dọn sạch"},{"dirty","Cần dọn"},{"inactive","Ngừng sử dụng"}}) { <option value="@pair.Key" selected="@(Context.Request.Query["state"] == pair.Key)">@pair.Value</option> }</select></div><button class="btn btn-primary">Lọc phòng</button></form>
@if (Model.Count == 0) { <div class="empty-state"><h2>Không có phòng phù hợp bộ lọc</h2><a asp-action="Index">Xem tất cả phòng →</a></div> }
<div class="board-grid">@foreach (var room in Model) { var stay = room.Reservations.FirstOrDefault(); <article class="board-card @(stay != null ? "occupied" : "") @(room.OperationalStatus == OperationalStatus.OutOfOrder ? "inactive" : "")"><div class="d-flex justify-content-between"><h2>@room.RoomNumber</h2><span class="muted">⌂</span></div><div class="room-type">@room.RoomType.Name · @room.RoomType.Capacity khách</div><strong class="small">@(stay != null ? "● Đang có khách" : "○ Phòng trống")</strong><div class="board-status"><span class="status @room.HousekeepingStatus">@(room.HousekeepingStatus == HousekeepingStatus.Clean ? "Sạch" : "Cần dọn")</span><span class="status @room.OperationalStatus">@(room.OperationalStatus == OperationalStatus.Active ? "Hoạt động" : "Ngừng sử dụng")</span></div>@if (stay != null) { <a asp-controller="Reservations" asp-action="Details" asp-route-id="@stay.Id" class="small">Xem khách lưu trú ↗</a> }<form method="post" asp-action="Housekeeping" asp-route-id="@room.Id"><select name="status" class="form-select" aria-label="Dọn phòng @room.RoomNumber"><option value="Clean" selected="@(room.HousekeepingStatus == HousekeepingStatus.Clean)">Sạch</option><option value="Dirty" selected="@(room.HousekeepingStatus == HousekeepingStatus.Dirty)">Cần dọn</option></select><button class="btn btn-light">Cập nhật</button></form>@if (User.IsInRole(Roles.Admin)) { <form method="post" asp-action="Operation" asp-route-id="@room.Id"><select name="status" class="form-select" aria-label="Khai thác phòng @room.RoomNumber"><option value="Active" selected="@(room.OperationalStatus == OperationalStatus.Active)">Hoạt động</option><option value="OutOfOrder" selected="@(room.OperationalStatus == OperationalStatus.OutOfOrder)">Ngừng sử dụng</option></select><button class="btn btn-light">Lưu</button></form> }</article> }</div>
