@model List<Reservation>
@{ ViewData["Title"] = "Lễ tân"; var tab = (string)ViewBag.Tab; }
<div class="section-heading"><div><div class="eyebrow">FRONT DESK</div><h1>Sẵn sàng cho một lời chào.</h1><p class="page-subtitle">Ngày làm việc @Ui.Date((DateOnly)ViewBag.Today) · Nhận phòng, chăm sóc khách và trả phòng.</p></div><a class="btn btn-primary" asp-controller="Reservations" asp-action="Create">＋ Đặt phòng trực tiếp</a></div>
<div class="tabs"><a class="@(tab == "arrivals" ? "active" : "")" asp-route-tab="arrivals">Khách đến / cần xử lý <b>@ViewBag.Arrivals hôm nay</b></a><a class="@(tab == "inhouse" ? "active" : "")" asp-route-tab="inhouse">Đang lưu trú <b>@ViewBag.InHouse</b></a><a class="@(tab == "departures" ? "active" : "")" asp-route-tab="departures">Đến hạn trả phòng <b>@ViewBag.Departures</b></a></div>
@if (!Model.Any()) { <div class="empty-state"><span>☼</span><h2>Mọi thứ đã được cập nhật</h2><p>Chưa có khách trong danh sách này. Chọn tab khác để tiếp tục.</p></div> }
else { <div class="panel table-panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Khách lưu trú</th><th>Phòng</th><th>Kỳ ở</th><th>Tình trạng</th><th>Thao tác</th></tr></thead><tbody>@foreach (var r in Model) { <tr><td><a asp-controller="Guests" asp-action="Details" asp-route-id="@r.GuestProfileId"><strong>@r.GuestProfile.FullName</strong></a><small>@r.ConfirmationCode</small></td><td><strong>@r.Room.RoomNumber</strong><small>@r.GuestCount khách</small></td><td>@Ui.Date(r.ArrivalDate)<small>đến @Ui.Date(r.DepartureDate)</small></td><td><span class="status @r.Status">@r.Status.Label()</span><small>@(r.Room.HousekeepingStatus == HousekeepingStatus.Clean ? "Sạch" : "Cần dọn") · @(r.Room.OperationalStatus == OperationalStatus.Active ? "Hoạt động" : "Ngừng sử dụng")</small></td><td><div class="actions">@if (r.Status == ReservationStatus.Confirmed) { <form method="post" asp-action="CheckIn" asp-route-id="@r.Id"><button class="btn btn-primary btn-sm">Nhận phòng</button></form> } @if (r.Folio != null) { <a class="btn btn-primary btn-sm" asp-action="Folio" asp-route-id="@r.Folio.Id">Dịch vụ & bảng kê →</a> }<a class="btn btn-light btn-sm" asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id">Chi tiết</a></div></td></tr> }</tbody></table></div></div> }
