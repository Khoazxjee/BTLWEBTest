@model GuestInput
@{ ViewData["Title"] = Model.Id == 0 ? "Tạo hồ sơ khách" : "Cập nhật hồ sơ khách"; }
<a class="back-link" asp-action="Index">← Danh sách khách</a><h1 class="mb-4">@ViewData["Title"]</h1><form method="post" class="panel form-panel"><partial name="_GuestFields" model="Model" /><div class="field"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control" rows="4"></textarea><span asp-validation-for="Notes"></span></div><p class="notice">Hồ sơ khách trực tiếp không tự gắn vào tài khoản chỉ dựa trên email trùng nhau.</p><button class="btn btn-primary">Lưu hồ sơ khách</button></form>
